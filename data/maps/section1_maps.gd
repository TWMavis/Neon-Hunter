class_name Section1Maps
extends RefCounted
## 第 1 區段「廢料層」的地圖。每層從一般地圖中隨機抽一張；Boss 層固定。
## 地形用矩形定義，單位是格（16px）：[x, y, 寬, 高, 種類]，種類 0 = 實心、1 = 單向平台。
## 設計原則：多個大迴圈讓獵物繞圈，角落、矮牆、牆邊口袋當「圍獵點」。

const S := 0
const O := 1


static func floors() -> Array[Dictionary]:
	var list: Array[Dictionary] = [_junction(), _sewer(), _scrapyard()]
	return list


